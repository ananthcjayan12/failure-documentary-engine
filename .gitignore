# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
ENV/
*.egg

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Project-generated artifacts
# Individual project runs are local working data and are never tracked.
projects/*/
# Shared project-level configuration remains trackable.
!projects/.fde-orchestrator.json
!projects/.gitkeep

# Media and temp files
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.part

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Node
node_modules/
.npm/

# Local tool/runtime state
.cache/
.vercel/
.turbo/
